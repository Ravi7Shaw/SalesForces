DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/be1
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=salesforce-raw
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
SALESFORCE_MODE=mock
# Compose address; use http://localhost:9003 when running the API on the host.
SALESFORCE_BASE_URL=http://mock-salesforce:9000
SALESFORCE_LOGIN_URL=
SALESFORCE_CLIENT_ID=mock-client
SALESFORCE_CLIENT_SECRET=mock-secret
SALESFORCE_REFRESH_TOKEN=mock-refresh
SALESFORCE_API_VERSION=v60.0

# --- API auth (set AUTH_ENABLED=false only for quick local hacking) ---
AUTH_ENABLED=true
API_KEY=dev-local-key
HMAC_SECRET=dev-local-hmac-secret

MAX_CONCURRENT_JOBS=2
AUTO_RESUME_ON_STARTUP=false
